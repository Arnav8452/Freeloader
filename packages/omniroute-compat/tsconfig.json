{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "ES2022",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@omniroute/*": ["./*"]
    },
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noImplicitAny": false,
    "strict": false,
    "skipLibCheck": true,
    "emitDeclarationOnly": true
  },
  "include": ["open-sse/**/*", "src/**/*", "index.ts"]
}
