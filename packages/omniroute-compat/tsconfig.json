{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "ES2022",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@omniroute/*": ["./*"]
    },
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": false,
    "noImplicitAny": false,
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "open-sse/**/*",
    "src/lib/**/*",
    "src/domain/**/*",
    "index.ts"
  ]
}
